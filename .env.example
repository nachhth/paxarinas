# Copia este ficheiro a .env e enche os valores. .env está fóra do repositorio.
# As variables só as usa o ETL; a app xerada non leva ningunha credencial.

# Contacto real para o User-Agent. Wikimedia bloquea os user-agents xenéricos.
PAXARINAS_CONTACTO=o-teu-correo@exemplo.gal

# Pausa en segundos entre peticións. Subir se aparecen erros 429.
PAXARINAS_PAUSA=0.35

# Só se fai falta: ruta completa a ffmpeg.exe. Útil xusto tras instalalo, quando
# as consolas xa abertas seguen co PATH vello. Normalmente déixase baleiro.
PAXARINAS_FFMPEG=

# https://ebird.org/api/keygen  (precisa conta de eBird)
EBIRD_API_KEY=

# Páxina da túa conta en https://xeno-canto.org (precisa correo verificado).
# Obrigatoria para descargar gravacións desde o 10 de outubro de 2025.
XENOCANTO_API_KEY=
